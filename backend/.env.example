# Copy to backend/.env and fill in your own values. Never commit the real .env.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
CLOUDINARY_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_SECRET_KEY="<api-secret>"
JWT_SECRET="<long-random-string>"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<strong-admin-password>"
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret of the webhook endpoint <BACKEND_URL>/api/order/stripe-webhook (Stripe dashboard →
# Developers → Webhooks; events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired). Without it, payments are still confirmed on the redirect back from Stripe.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Where Stripe redirects back to after checkout (the customer storefront)
FRONTEND_URL="http://localhost:5173"
# Public URL of this API, used for Stripe return URLs (required in production; defaults to
# http://localhost:<PORT> in development). Never derived from the request's Host header.
BACKEND_URL="http://localhost:4000"
# Admin panel URL — allowed by CORS together with FRONTEND_URL (required in production)
ADMIN_URL="http://localhost:5174"
# Optional: extra allowed browser origins, comma-separated (e.g. Vercel preview domains)
# CORS_ORIGINS="https://my-preview.vercel.app"
# Optional: read-only demo admin for portfolio visitors (can view the dashboard, products and orders
# with customer details masked; every change is refused). Leave unset to disable.
# DEMO_ADMIN_EMAIL="demo-admin@example.com"
# DEMO_ADMIN_PASSWORD="<demo-password>"
# Optional: the shared demo shopper account (create it by signing up). Its name and password can't be changed.
# DEMO_CUSTOMER_EMAIL="demo@example.com"
# Optional: database name (defaults to e-commerce, the existing database)
# MONGODB_DB="e-commerce"
